# ============================================
# Baefikra Environment Variables Template
# Copy this file to .env.local and fill in values
# ============================================

# ============================================
# Core Application
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Database
# ============================================
MONGODB_URI=mongodb://localhost:27017/baefikra

# ============================================
# Redis (Cache, Sessions & Email Queue)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Algolia Search (Optional)
# ============================================
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# ============================================
# Payment — Razorpay
# ============================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ============================================
# Shipping — Delhivery
# ============================================
DELHIVERY_API_KEY=
DELHIVERY_API_URL=https://track.delhivery.com/api
DELHIVERY_CLIENT_NAME=Baefikra
DELHIVERY_PICKUP_LOCATION=

# ============================================
# AWS Services (Image Storage)
# ============================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=

# ============================================
# Email — Resend
# ============================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@baefikra.com
SUPPORT_EMAIL=support@baefikra.com

# ============================================
# Cron & Background Jobs
# ============================================
CRON_SECRET=generate-a-random-secret-here

# ============================================
# Analytics & Monitoring
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
